@using System.Text.Json
@implements IAsyncDisposable
@inject SagaStreamClient Streams

<div class="saga-journey">
    @if (streamMessage is not null) { <p class="muted" role="status">@streamMessage</p> }
    <div class="panel-heading">
        <div>
            <p class="eyebrow">Pulsar choreography</p>
            <h2>Event journey</h2>
        </div>
        @if (events.Count > 0)
        {
            <span class="count-badge">@events.Count events</span>
        }
    </div>

    @if (OrderId is null)
    {
        <p class="muted">Place an order to watch its events arrive across the three services.</p>
    }
    else if (events.Count == 0)
    {
        <p class="muted">Waiting for the first event…</p>
    }
    else
    {
        <ol class="journey">
            @foreach (var item in events)
            {
                <li class="journey-item source-@item.Source @(IsFailure(item) ? "is-failure" : null)">
                    <span class="journey-dot"></span>
                    <div class="journey-body">
                        <div class="journey-line">
                            <strong>@Label(item)</strong>
                            <span class="journey-source">@item.Source</span>
                            <span class="muted journey-time">@item.OccurredAt.LocalDateTime.ToString("HH:mm:ss.fff")</span>
                        </div>
                        @if (Describe(item) is { Length: > 0 } detail)
                        {
                            <div class="journey-detail @(IsFailure(item) ? "negative" : null)">@detail</div>
                        }
                    </div>
                </li>
            }
        </ol>
    }
</div>

@code {
    [Parameter] public Guid? OrderId { get; set; }

    [Parameter] public EventCallback<SagaStreamMessage> OnMessage { get; set; }

    private readonly List<SagaEvent> events = [];
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private SagaStreamClient.Subscription? subscription;
    private Guid? loadedFor;
    private string? streamMessage;
    private bool disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || OrderId == loadedFor) return;
        loadedFor = OrderId;
        if (subscription is not null) await subscription.DisposeAsync();
        subscription = null;
        events.Clear();
        streamMessage = null;
        if (OrderId is not { } id) return;
        var next = await Streams.ConnectAsync(id, (kind, data) => InvokeAsync(async () =>
        {
            if (disposed || OrderId != id) return;
            if (kind == "saga")
            {
                var row = data.Deserialize<SagaEvent>(JsonOptions)!;
                if (events.Any(x => x.Seq == row.Seq)) return;
                events.Add(row);
                events.Sort((a, b) => a.Seq.CompareTo(b.Seq));
                streamMessage = null;
            }
            if (kind == "stalled") streamMessage = data.GetProperty("reason").GetString();
            if (kind == "terminal") streamMessage = null;
            await OnMessage.InvokeAsync(new SagaStreamMessage(kind, data));
            StateHasChanged();
        }));
        if (disposed || OrderId != id) await next.DisposeAsync();
        else subscription = next;
        if (!disposed) StateHasChanged();
    }
    private static bool IsFailure(SagaEvent item) =>
        item.EventType is "ReservationFailed" or "PaymentFailed";

    private static string Label(SagaEvent item) => item.EventType switch
    {
        "OrderPlaced" => "Order placed",
        "ReservationSucceeded" => "Stock reserved",
        "ReservationFailed" => "Reservation rejected",
        "PaymentSucceeded" => "Payment charged",
        "PaymentFailed" => "Payment declined",
        "StockReleased" => "Stock released — compensation",
        _ => item.EventType
    };

    private static string Describe(SagaEvent item)
    {
        if (item.Detail is not { } detail || detail.ValueKind != JsonValueKind.Object)
        {
            return string.Empty;
        }

        if (detail.TryGetProperty("reason", out var reason))
        {
            return reason.GetString() ?? string.Empty;
        }

        if (detail.TryGetProperty("amount", out var amount) && amount.TryGetDecimal(out var value))
        {
            return $"amount {value:C}";
        }

        if (detail.TryGetProperty("totalAmount", out var total) && total.TryGetDecimal(out var totalValue))
        {
            var lineCount = detail.TryGetProperty("lineCount", out var lc) ? lc.GetInt32() : 0;
            return $"{lineCount} line(s), total {totalValue:C}";
        }

        if (detail.TryGetProperty("releasedLines", out var lines) && lines.ValueKind == JsonValueKind.Array)
        {
            var parts = lines.EnumerateArray()
                .Select(line => $"{line.GetProperty("sku").GetString()} ×{line.GetProperty("quantity").GetInt32()}");
            return "released " + string.Join(", ", parts);
        }

        return string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (subscription is not null) await subscription.DisposeAsync();
    }
}